{
  "doctype": "DocType",
  "name": "LMS Tour Progress",
  "module": "LMS",
  "autoname": "prompt",
  "engine": "InnoDB",
  "field_order": [
    "member",
    "page",
    "tour",
    "revision",
    "status",
    "step",
    "started_count",
    "completed_count",
    "skipped_count",
    "helpful"
  ],
  "fields": [
    {
      "fieldname": "member",
      "fieldtype": "Link",
      "label": "Member",
      "read_only": 1,
      "in_list_view": 1,
      "options": "User"
    },
    {
      "fieldname": "page",
      "fieldtype": "Data",
      "label": "Page",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "tour",
      "fieldtype": "Data",
      "label": "Tour",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "revision",
      "fieldtype": "Data",
      "label": "Revision",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "read_only": 1,
      "in_list_view": 1,
      "options": "Not Started\nIn Progress\nPaused\nCompleted\nSkipped"
    },
    {
      "fieldname": "step",
      "fieldtype": "Int",
      "label": "Step",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "started_count",
      "fieldtype": "Int",
      "label": "Starts",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "completed_count",
      "fieldtype": "Int",
      "label": "Completions",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "skipped_count",
      "fieldtype": "Int",
      "label": "Skips",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "helpful",
      "fieldtype": "Select",
      "label": "Helpful",
      "read_only": 1,
      "in_list_view": 1,
      "options": "\nYes\nNo"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Moderator",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
