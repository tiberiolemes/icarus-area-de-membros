{
  "doctype": "DocType",
  "name": "LMS Privacy Settings",
  "module": "LMS",
  "issingle": 1,
  "engine": "InnoDB",
  "field_order": [
    "controller_name",
    "contact_channel",
    "purposes_and_bases",
    "retention_policy",
    "service_providers",
    "privacy_notice",
    "publication_approved",
    "approved_revision"
  ],
  "fields": [
    {
      "fieldname": "controller_name",
      "fieldtype": "Data",
      "label": "Responsible controller"
    },
    {
      "fieldname": "contact_channel",
      "fieldtype": "Small Text",
      "label": "Privacy contact channel"
    },
    {
      "fieldname": "purposes_and_bases",
      "fieldtype": "Text",
      "label": "Purposes and legal bases"
    },
    {
      "fieldname": "retention_policy",
      "fieldtype": "Text",
      "label": "Retention by data category"
    },
    {
      "fieldname": "service_providers",
      "fieldtype": "Text",
      "label": "Service providers and transfers"
    },
    {
      "fieldname": "privacy_notice",
      "fieldtype": "Text Editor",
      "label": "Privacy notice"
    },
    {
      "fieldname": "publication_approved",
      "fieldtype": "Check",
      "label": "Approve this information for public registration"
    },
    {
      "fieldname": "approved_revision",
      "fieldtype": "Data",
      "label": "Approved policy revision",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "track_changes": 1
}
