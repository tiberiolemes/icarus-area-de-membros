VITE_SUPABASE_URL=http://127.0.0.1:58521
VITE_SUPABASE_ANON_KEY=
# Provider secrets belong in server-side Supabase secrets, never VITE_ variables.
# Aviso de versão nova no painel: repositório consultado nas Releases do GitHub (padrão: o oficial). Vazio desliga o aviso.
# VITE_ICARUS_UPDATE_REPO=tiberiolemes/icarus-area-de-membros
# Turnstile no login e no checkout: chave pública do widget. O segredo TURNSTILE_SECRET_KEY vai só nos secrets das Edge Functions.
# VITE_TURNSTILE_SITE_KEY=
